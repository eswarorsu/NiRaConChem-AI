"use client";

import { Canvas, useFrame, useThree } from "@react-three/fiber";
import { useEffect, useMemo, useRef } from "react";
import {
  BufferGeometry,
  Color,
  Float32BufferAttribute,
  FogExp2,
  Group,
  LineBasicMaterial,
  LineSegments,
  Points,
  PointsMaterial,
} from "three";

/* ---------------------------------------------------------------------------
   A deterministic PRNG. The scene is generated, not authored, but it must be
   identical on every load so the composition behind the headline never lands
   in a bad place.
--------------------------------------------------------------------------- */
function makeRandom(seed: number) {
  let state = seed >>> 0;
  return () => {
    state = (state * 1664525 + 1013904223) >>> 0;
    return state / 4294967296;
  };
}

/* Ink on paper. The drawing is dark-on-light now, so "strength" means more
   opaque and darker rather than brighter. */
const ACCENT = new Color("#6b4f2a");
const STEEL = new Color("#8a8172");
const BONE = new Color("#3a342b");

type Density = { molecules: number; dust: number; struts: number };

/* ---------------------------------------------------------------------------
   Structural lattice — the "construction" half of the composition. A receding
   orthographic-feeling frame of struts and slab lines, drifting slowly.
--------------------------------------------------------------------------- */
function Lattice({ struts }: { struts: number }) {
  const geometry = useMemo(() => {
    const random = makeRandom(9137);
    const positions: number[] = [];
    const colors: number[] = [];

    const bays = struts;
    const spanX = 26;
    const spanZ = 22;
    const levels = 4;
    const levelH = 3.4;

    const push = (
      ax: number, ay: number, az: number,
      bx: number, by: number, bz: number,
      strength: number,
    ) => {
      positions.push(ax, ay, az, bx, by, bz);
      const c = STEEL.clone().lerp(BONE, strength * 0.8);
      colors.push(c.r, c.g, c.b, c.r, c.g, c.b);
    };

    for (let i = 0; i <= bays; i += 1) {
      const t = i / bays;
      const x = -spanX / 2 + t * spanX;
      const z = -spanZ / 2 + random() * spanZ;
      const height = levelH * levels;
      // Column
      push(x, -height / 2, z, x, height / 2 - random() * 4, z, 0.35 + random() * 0.4);
      // Slab edges at each level
      for (let level = 0; level <= levels; level += 1) {
        const y = -height / 2 + level * levelH;
        const w = 2.2 + random() * 3.4;
        push(x - w, y, z, x + w, y, z, 0.2 + random() * 0.35);
      }
    }

    // Ground datum lines: a technical grid that anchors the frame in space.
    for (let i = -6; i <= 6; i += 1) {
      const z = i * 2.1;
      push(-spanX / 2 - 4, -levelH * 2 - 0.6, z, spanX / 2 + 4, -levelH * 2 - 0.6, z, 0.1);
    }

    const geo = new BufferGeometry();
    geo.setAttribute("position", new Float32BufferAttribute(positions, 3));
    geo.setAttribute("color", new Float32BufferAttribute(colors, 3));
    return geo;
  }, [struts]);

  const material = useMemo(
    () => new LineBasicMaterial({ vertexColors: true, transparent: true, opacity: 0.3 }),
    [],
  );

  const ref = useRef<LineSegments>(null);
  useFrame((state) => {
    if (!ref.current) return;
    ref.current.rotation.y = -0.34 + Math.sin(state.clock.elapsedTime * 0.06) * 0.04;
  });

  return <lineSegments args={[geometry, material]} position={[9, -1.6, -13]} ref={ref} />;
}

/* ---------------------------------------------------------------------------
   Molecular / network cluster — the "chemistry + AI" half. Nodes are points,
   bonds are the segments between near neighbours; a travelling highlight walks
   the structure so it reads as a live system rather than a decorative object.
--------------------------------------------------------------------------- */
function Molecule({ count }: { count: number }) {
  const { nodeGeometry, bondGeometry, nodePositions } = useMemo(() => {
    const random = makeRandom(4271);
    const pts: number[] = [];

    // Nodes sit on a jittered spherical shell — dense enough to read as a
    // structure, sparse enough that individual bonds stay legible.
    for (let i = 0; i < count; i += 1) {
      const u = random() * 2 - 1;
      const theta = random() * Math.PI * 2;
      const r = 4.4 + random() * 2.6;
      const s = Math.sqrt(1 - u * u);
      pts.push(r * s * Math.cos(theta), r * u * 0.72, r * s * Math.sin(theta));
    }

    const nodeGeo = new BufferGeometry();
    nodeGeo.setAttribute("position", new Float32BufferAttribute(pts, 3));

    const bonds: number[] = [];
    const bondColors: number[] = [];
    const maxDistance = 3.15;
    for (let i = 0; i < count; i += 1) {
      for (let j = i + 1; j < count; j += 1) {
        const dx = pts[i * 3] - pts[j * 3];
        const dy = pts[i * 3 + 1] - pts[j * 3 + 1];
        const dz = pts[i * 3 + 2] - pts[j * 3 + 2];
        const d = Math.sqrt(dx * dx + dy * dy + dz * dz);
        if (d < maxDistance) {
          bonds.push(pts[i * 3], pts[i * 3 + 1], pts[i * 3 + 2]);
          bonds.push(pts[j * 3], pts[j * 3 + 1], pts[j * 3 + 2]);
          const c = ACCENT.clone().lerp(STEEL, 1 - (1 - d / maxDistance) * 0.85);
          bondColors.push(c.r, c.g, c.b, c.r, c.g, c.b);
        }
      }
    }

    const bondGeo = new BufferGeometry();
    bondGeo.setAttribute("position", new Float32BufferAttribute(bonds, 3));
    bondGeo.setAttribute("color", new Float32BufferAttribute(bondColors, 3));

    return { nodeGeometry: nodeGeo, bondGeometry: bondGeo, nodePositions: pts };
  }, [count]);

  const nodeMaterial = useMemo(
    () =>
      new PointsMaterial({
        size: 0.16,
        sizeAttenuation: true,
        color: new Color("#241f18"),
        transparent: true,
        opacity: 0.85,
        depthWrite: false,
      }),
    [],
  );

  const bondMaterial = useMemo(
    () =>
      new LineBasicMaterial({
        vertexColors: true,
        transparent: true,
        opacity: 0.42,
        depthWrite: false,
      }),
    [],
  );

  // A small cluster of "active" nodes that pulses along the structure, so the
  // molecule reads as something being traversed rather than something spinning.
  const activeGeometry = useMemo(() => {
    const geo = new BufferGeometry();
    geo.setAttribute("position", new Float32BufferAttribute(new Float32Array(9), 3));
    return geo;
  }, []);

  const activeMaterial = useMemo(
    () =>
      new PointsMaterial({
        size: 0.5,
        sizeAttenuation: true,
        color: ACCENT,
        transparent: true,
        opacity: 1,
        depthWrite: false,
      }),
    [],
  );

  const group = useRef<Group>(null);
  const active = useRef<Points>(null);

  useFrame((state) => {
    const t = state.clock.elapsedTime;
    if (group.current) {
      group.current.rotation.y = t * 0.055;
      group.current.rotation.x = Math.sin(t * 0.22) * 0.08;
    }
    if (active.current) {
      const total = nodePositions.length / 3;
      const attribute = active.current.geometry.getAttribute("position");
      for (let k = 0; k < 3; k += 1) {
        const index = Math.floor((t * 1.7 + k * 7.3) % total);
        attribute.setXYZ(
          k,
          nodePositions[index * 3],
          nodePositions[index * 3 + 1],
          nodePositions[index * 3 + 2],
        );
      }
      attribute.needsUpdate = true;
    }
  });

  return (
    <group position={[7.6, 0.8, -1]} ref={group}>
      <lineSegments args={[bondGeometry, bondMaterial]} />
      <points args={[nodeGeometry, nodeMaterial]} />
      <points args={[activeGeometry, activeMaterial]} ref={active} />
    </group>
  );
}

/* ---------------------------------------------------------------------------
   Suspended data particles. Cheap: one Points cloud, moved on the GPU-friendly
   path of a single attribute update per frame.
--------------------------------------------------------------------------- */
function Dust({ count }: { count: number }) {
  const geometry = useMemo(() => {
    const random = makeRandom(881);
    const positions = new Float32Array(count * 3);
    for (let i = 0; i < count; i += 1) {
      positions[i * 3] = (random() - 0.5) * 46;
      positions[i * 3 + 1] = (random() - 0.5) * 24;
      positions[i * 3 + 2] = (random() - 0.5) * 26 - 4;
    }
    const geo = new BufferGeometry();
    geo.setAttribute("position", new Float32BufferAttribute(positions, 3));
    return geo;
  }, [count]);

  const material = useMemo(
    () =>
      new PointsMaterial({
        size: 0.055,
        sizeAttenuation: true,
        color: new Color("#8a8172"),
        transparent: true,
        opacity: 0.5,
        depthWrite: false,
      }),
    [],
  );

  const ref = useRef<Points>(null);
  useFrame((state) => {
    if (ref.current) {
      ref.current.rotation.y = state.clock.elapsedTime * 0.012;
    }
  });

  return <points args={[geometry, material]} ref={ref} />;
}

/* Camera drift toward the pointer — present, but under the threshold of
   conscious notice. Uses normalised pointer state that R3F already tracks. */
function PointerCamera({ enabled }: { enabled: boolean }) {
  const { camera } = useThree();
  useFrame((state, delta) => {
    if (!enabled) return;
    const targetX = state.pointer.x * 1.35;
    const targetY = state.pointer.y * 0.75;
    const k = 1 - Math.pow(0.0015, delta);
    camera.position.x += (targetX - camera.position.x) * k;
    camera.position.y += (1 + targetY - camera.position.y) * k;
    camera.lookAt(0, 0, 0);
  });
  return null;
}

function Fog({ color, density }: { color: string; density: number }) {
  const { scene } = useThree();
  // Assigning scene.fog is a side effect on an object React does not own, so it
  // belongs in an effect — useMemo is for computing values and may be discarded
  // or re-run at React's discretion.
  useEffect(() => {
    const previous = scene.fog;
    scene.fog = new FogExp2(color, density);
    return () => {
      scene.fog = previous;
    };
  }, [scene, color, density]);
  return null;
}

export type HeroSceneProps = {
  density: Density;
  animate: boolean;
};

export default function HeroScene({ density, animate }: HeroSceneProps) {
  return (
    <Canvas
      camera={{ position: [0, 1, 19], fov: 44 }}
      dpr={[1, 1.75]}
      frameloop={animate ? "always" : "demand"}
      gl={{ antialias: true, alpha: true, powerPreference: "high-performance" }}
    >
      <Fog color="#f8f5ee" density={0.03} />
      <PointerCamera enabled={animate} />
      <Lattice struts={density.struts} />
      <Molecule count={density.molecules} />
      <Dust count={density.dust} />
    </Canvas>
  );
}

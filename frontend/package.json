{
  "name": "niraconchem-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "icons": "python scripts/build-brand-icons.py",
    "font:wordmark": "pyftsubset public/fonts/OffBit-DotBold.ttf --output-file=public/fonts/OffBit-DotBold.woff2 --flavor=woff2 --text=NiRaConChem --layout-features= --no-hinting --desubroutinize --name-IDs=",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^13.2.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.7",
    "typescript": "latest",
    "vitest": "^3.2.4"
  }
}
